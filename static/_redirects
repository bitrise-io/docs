# The site root has no content of its own now that each locale has its
# own baseUrl (/en/, /ja/, ...) — the homepage only exists per-locale
# (build/en/index.html, build/ja/index.html), never at bare /. Redirect to
# the default locale. Must be a real HTTP redirect, not a promoted static
# file — Docusaurus's client-side router has no route for bare "/", so
# serving real HTML there causes a hydration mismatch and a client-side
# 404 (tried and reverted, see promote-root-static-files.js).
/  /en/  301

# Static assets moved under the locale directories along with the rest of
# static/ (same baseUrl change as above), so the root paths that external
# pages, emails and older docs revisions hotlink no longer exist. These two
# prefixes are 1800+ files / ~184 MB, already duplicated per locale by the
# build, so they are redirected rather than promoted to the root a third
# time. Everything small enough to just copy is handled by
# scripts/promote-root-static-files.js instead.
/img/*    /en/img/:splat    301
/fonts/*  /en/fonts/:splat  301

# Legacy Japanese-locale URL prefix from the old Paligo-era site — that
# scheme is dead, so redirect to the English equivalent. /ja/ is NOT listed
# here: it is now a real, served locale (see docusaurus.config.ts i18n
# config) — redirecting it away would silently break every /ja/ page even
# though the build succeeds.
/jp/*  /en/:splat  301
