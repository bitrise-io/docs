https://:project.pages.dev/*
  X-Robots-Tag: noindex

# The ja locale is served but not translated yet: there is no i18n/ja
# directory, so every /ja/ page renders the English content, and Docusaurus
# advertises those URLs as the Japanese alternates (hreflang) plus its own
# /ja/sitemap.xml. Keep them out of the index until real translations land,
# otherwise this is ~440 pages of duplicate English content. Drop this rule
# in the same change that adds i18n/ja and the locale switcher.
/ja/*
  X-Robots-Tag: noindex

/onboarding-for-agents.md
  Content-Type: text/plain; charset=utf-8

# Same file, per-locale copy: static/ is emitted under each locale's own
# baseUrl now, so this page is reachable at both the root (promoted by
# scripts/promote-root-static-files.js) and under /en/.
/en/onboarding-for-agents.md
  Content-Type: text/plain; charset=utf-8
